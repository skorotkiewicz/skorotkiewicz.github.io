<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>2012/11 on Sebastian Korotkiewicz - Tech{{log}}</title><link>https://sekor.eu.org/archive/2012/11/</link><description>Recent content in 2012/11 on Sebastian Korotkiewicz - Tech{{log}}</description><generator>Hugo</generator><language>en-US</language><lastBuildDate>Fri, 30 Nov 2012 22:03:27 +0000</lastBuildDate><atom:link href="https://sekor.eu.org/archive/2012/11/index.xml" rel="self" type="application/rss+xml"/><item><title>List crontab for all users</title><link>https://sekor.eu.org/techlog/list-crontab-for-all-users/</link><pubDate>Fri, 30 Nov 2012 22:03:27 +0000</pubDate><guid>https://sekor.eu.org/techlog/list-crontab-for-all-users/</guid><description>&lt;pre tabindex="0"&gt;&lt;code&gt;for user in $(cut -f1 -d: /etc/passwd); do&#10; echo $user; crontab -u $user -l;&#10;done&#10;&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;&lt;code&gt;for user in $(cut -f1 -d: /etc/passwd); do echo $user; crontab -u $user -l; done&lt;/code&gt;&lt;/p&gt;</description></item><item><title>Own IRC Server on Debian</title><link>https://sekor.eu.org/techlog/own-irc-server-on-debian/</link><pubDate>Fri, 30 Nov 2012 20:20:50 +0000</pubDate><guid>https://sekor.eu.org/techlog/own-irc-server-on-debian/</guid><description>&lt;ol&gt;&#10;&lt;li&gt;&lt;code&gt;aptitude install ircd-irc2&lt;/code&gt;&lt;/li&gt;&#10;&lt;li&gt;&lt;code&gt;nano /etc/ircd/ircd.conf&lt;/code&gt;&lt;/li&gt;&#10;&lt;/ol&gt;&#10;&lt;pre tabindex="0"&gt;&lt;code&gt;M:irc.&amp;lt;HOSTNAME&amp;gt;::&amp;lt;COUNTRY&amp;gt;::000A&#10;A:&amp;lt;NAME&amp;gt;:&amp;lt;EMAIL&amp;gt;::&amp;lt;COMPANYNAME&amp;gt;:&#10;Y:1:90::100:512000:5.5:100.100&#10;Y:2:90::300:512000:5.5:250.250&#10;I:*:::0:1&#10;I:127.0.0.1/32:::0:1&#10;I:192.168.0.0/24::::0:2&#10;P::::6667:&#10;&lt;/code&gt;&lt;/pre&gt;&lt;ol start="3"&gt;&#10;&lt;li&gt;&lt;/li&gt;&#10;&lt;/ol&gt;&#10;&lt;pre tabindex="0"&gt;&lt;code&gt;nano /etc/ircd/ircd.motd&#10;Your welcome text&#10;&lt;/code&gt;&lt;/pre&gt;&lt;ol start="4"&gt;&#10;&lt;li&gt;&lt;code&gt;/etc/init.d/ircd restart&lt;/code&gt;&lt;/li&gt;&#10;&lt;/ol&gt;</description></item><item><title>if echo</title><link>https://sekor.eu.org/techlog/if-echo/</link><pubDate>Fri, 02 Nov 2012 17:02:48 +0000</pubDate><guid>https://sekor.eu.org/techlog/if-echo/</guid><description>&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-php" data-lang="php"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;$value &lt;span style="color:#f92672"&gt;=&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#39;aaa&amp;#39;&lt;/span&gt;;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#66d9ef"&gt;echo&lt;/span&gt; $value&lt;span style="color:#f92672"&gt;==&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#39;aaa&amp;#39;&lt;/span&gt; &lt;span style="color:#f92672"&gt;?&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#39;yes&amp;#39;&lt;/span&gt; &lt;span style="color:#f92672"&gt;:&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#39;no&amp;#39;&lt;/span&gt;;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;example 1&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-php" data-lang="php"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#66d9ef"&gt;echo&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#34;always say this &amp;#34;&lt;/span&gt; &lt;span style="color:#f92672"&gt;.&lt;/span&gt; ( ($test &lt;span style="color:#f92672"&gt;==&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#34;true&amp;#34;&lt;/span&gt;) &lt;span style="color:#f92672"&gt;?&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#e6db74"&gt;&amp;#34;Say this if that is true&amp;#34;&lt;/span&gt; &lt;span style="color:#f92672"&gt;:&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#34;&amp;#34;&lt;/span&gt;) &lt;span style="color:#f92672"&gt;.&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#34; Always say this at the end.&amp;#34;&lt;/span&gt;;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;example 2&lt;/p&gt;&#10;&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-php" data-lang="php"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#66d9ef"&gt;echo&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#39;&amp;lt;option value=&amp;#34;&amp;#39;&lt;/span&gt;&lt;span style="color:#f92672"&gt;.&lt;/span&gt;$value&lt;span style="color:#f92672"&gt;.&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#39;&amp;#34;&amp;#39;&lt;/span&gt;&lt;span style="color:#f92672"&gt;.&lt;/span&gt;($value&lt;span style="color:#f92672"&gt;==&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#39;United States&amp;#39;&lt;/span&gt; &lt;span style="color:#f92672"&gt;?&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#e6db74"&gt;&amp;#39;selected=&amp;#34;selected&amp;#34;&amp;#39;&lt;/span&gt; &lt;span style="color:#f92672"&gt;:&lt;/span&gt; &lt;span style="color:#e6db74"&gt;&amp;#39;&amp;#39;&lt;/span&gt;)&lt;span style="color:#f92672"&gt;.&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#39;&amp;gt;&amp;#39;&lt;/span&gt;&lt;span style="color:#f92672"&gt;.&lt;/span&gt;$value&lt;span style="color:#f92672"&gt;.&lt;/span&gt;&lt;span style="color:#e6db74"&gt;&amp;#39;&amp;lt;/option&amp;gt;&amp;#39;&lt;/span&gt;;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&