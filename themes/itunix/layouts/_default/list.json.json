{{- $pages := .RegularPages -}}
{{- if .IsHome -}}{{- $pages = .Site.RegularPages -}}{{- end -}}
{{- $items := slice -}}
{{- range $pages.ByDate.Reverse -}}
  {{- $items = $items | append (dict "title" .Title "url" .RelPermalink "tags" (.Params.tags | default slice) "content" (.Plain | htmlUnescape)) -}}
{{- end -}}
{{- $items | uniq | jsonify -}}
