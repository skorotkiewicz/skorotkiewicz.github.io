<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Patch on Sebastian Korotkiewicz - Tech{{log}}</title><link>https://sekor.eu.org/tags/patch/</link><description>Recent content in Patch on Sebastian Korotkiewicz - Tech{{log}}</description><generator>Hugo</generator><language>en-US</language><lastBuildDate>Wed, 25 Nov 2026 16:12:28 +0000</lastBuildDate><atom:link href="https://sekor.eu.org/tags/patch/index.xml" rel="self" type="application/rss+xml"/><item><title>patch things up</title><link>https://sekor.eu.org/note/patch-things-up/</link><pubDate>Wed, 25 Nov 2026 16:12:28 +0000</pubDate><guid>https://sekor.eu.org/note/patch-things-up/</guid><description>&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-sh" data-lang="sh"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c1"&gt;# create a patch (pick one)&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;git diff src/style.css &amp;gt; my.patch &lt;span class="c1"&gt;# uncommitted changes&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;git diff HEAD~1 -- src/style.css &amp;gt; my.patch &lt;span class="c1"&gt;# vs previous commit&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;git diff origin/main -- src/style.css &amp;gt; my.patch &lt;span class="c1"&gt;# vs GitHub&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c1"&gt;# without git: needs a copy of the original&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;cp src/style.css /tmp/style.orig &lt;span class="c1"&gt;# back up BEFORE editing&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c1"&gt;# edit src/style.css&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;diff -u /tmp/style.orig src/style.css &amp;gt; my.patch&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c1"&gt;# diff -u --label a/src/style.css --label b/src/style.css /tmp/style.orig src/style.css &amp;gt; my.patch&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c1"&gt;# apply / revert (run from the project root)&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;patch -p1 --dry-run &amp;lt; my.patch &lt;span class="c1"&gt;# test first&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;patch -p1 &amp;lt; my.patch &lt;span class="c1"&gt;# apply&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;patch -p1 -R &amp;lt; my.patch &lt;span class="c1"&gt;# revert&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c1"&gt;# or with git&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;git apply --check my.patch&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;git apply my.patch&#10;&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;git apply -R my.patch &lt;span class="c1"&gt;# revert&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description></item></channel></rss>