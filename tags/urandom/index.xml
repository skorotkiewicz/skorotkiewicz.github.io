<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Urandom on Sebastian Korotkiewicz - Tech{{log}}</title><link>https://sekor.eu.org/tags/urandom/</link><description>Recent content in Urandom on Sebastian Korotkiewicz - Tech{{log}}</description><generator>Hugo</generator><language>en-US</language><lastBuildDate>Sun, 10 Jan 2016 18:10:58 +0200</lastBuildDate><atom:link href="https://sekor.eu.org/tags/urandom/index.xml" rel="self" type="application/rss+xml"/><item><title>'Music' from /dev/urandom</title><link>https://sekor.eu.org/techlog/music-from-dev-urandom/</link><pubDate>Sun, 10 Jan 2016 18:10:58 +0200</pubDate><guid>https://sekor.eu.org/techlog/music-from-dev-urandom/</guid><description>&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-bash" data-lang="bash"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;cat /dev/urandom &lt;span class="p"&gt;|&lt;/span&gt; hexdump -v -e &lt;span class="s1"&gt;&amp;#39;/1 &amp;#34;%u\n&amp;#34;&amp;#39;&lt;/span&gt; &lt;span class="p"&gt;|&lt;/span&gt; awk &lt;span class="s1"&gt;&amp;#39;{ split(&amp;#34;0,2,4,5,7,9,11,12&amp;#34;,a,&amp;#34;,&amp;#34;); for (i = 0; i &amp;lt; 1; i+= 0.0001) printf(&amp;#34;%08X\n&amp;#34;, 100*sin(1382*exp((a[$1 % 8]/12)*log(2))*i)) }&amp;#39;&lt;/span&gt; &lt;span class="p"&gt;|&lt;/span&gt; xxd -r -p &lt;span class="p"&gt;|&lt;/span&gt; aplay -c &lt;span class="m"&gt;2&lt;/span&gt; -f S32_LE -r &lt;span class="m"&gt;16000&lt;/span&gt;&#10;&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description></item></channel></rss>